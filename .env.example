MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MAIL_USERNAME=
MAIL_PASSWORD=

# Offsite-бэкап на Яндекс.Диск.
# Токен приложения с правами cloud_api:disk.read и cloud_api:disk.write.
YANDEX_DISK_TOKEN=
YANDEX_DISK_DIR=/tattoo-backups

# Ключ шифрования токена Яндекс.Диска (base64, 32 байта): openssl rand -base64 32
# Смена ключа делает ранее сохранённый токен нечитаемым — токен придётся ввести заново.
BACKUP_ENCRYPTION_KEY=
